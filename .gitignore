# under docs/ instead.
docs/**/Prof*.txt
docs/**/PROPOSAL_REVISION_BRIEF.md

# Raw immutable OJP corpus batches (large data, never versioned)
DATA/corpus_raw/

# Adzuna benchmark (separate from extraction corpus; flagged, truncated descriptions)
DATA/corpus_benchmark/

# Gold-standard sentence pool, samples, worksheets, annotations (reproducible from
# the gold_standard/ code + the raw corpus; the pool alone is ~124 MB)
DATA/gold_standard/

# Multi-LLM ensemble runs: raw model responses and consensus output. They embed
# corpus sentences verbatim (LOCAL ONLY, CLAUDE.md section 6), and they must
# stay out of DATA/gold_standard/ so annotators remain blind to LLM output.
DATA/labeling/

# Extraction-model inputs and outputs (fivetag/): train/dev rows exported from
# the gold standard, LLM benchmark runs, synthetic test rows, model checkpoints.
# The gold exports and the runs embed corpus sentences verbatim (LOCAL ONLY).
DATA/fivetag/

# Annotation collector database — contains real annotator judgements (and the
# WAL/SHM sidecars SQLite creates). The DB is the deliverable, not source.
*.sqlite
*.sqlite-wal
*.sqlite-shm
data/annotations.sqlite*
annotation_server/data/

